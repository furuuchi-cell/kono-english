rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: 自分のデータのみ読み書き可能、ただし管理者は全員のデータを読める
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // User sub-collections (progress, sessions, streak)
    match /users/{userId}/{subcol}/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Classes: 認証済みユーザーは読める、管理者（adminId）のみ書き込み可能
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.adminId == request.auth.uid;
    }

    // Class sub-collections (ranges, tests, test results, sessions)
    match /classes/{classId}/{subcol}/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Session answers (deeply nested)
    match /classes/{classId}/sessions/{sessionId}/answers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Settings (maintenance, wordOverrides): 認証済みなら読める、書き込みは管理者のみ
    // 注意: Firestoreルールではカスタムクレームがないとrole判定が難しいため、
    // settingsは認証済みユーザーに読み書き許可（アプリ側で管理者チェック済み）
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Worksheets: 認証済みユーザーは読める、管理者がアプリ側で書き込み制御
    match /worksheets/{worksheetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Submissions: 認証済みユーザーは読める、自分の提出は書き込み可能、先生もアプリ側で書き込み
    match /submissions/{submissionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
